# ============================================================
# pyLoopSage .gitignore
# Patterns without a leading "/" match at any depth; "/name" matches only in the repository root.
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
*.whl
pip-wheel-metadata/

# ---- Virtual environments and local interpreter pins ----
env/
venv/
.venv/
ENV/
.python-version
.tool-versions
.envrc
.direnv/

# ---- Environment files and secrets (the template stays tracked) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Caches and tool output ----
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.pytype/
.pyre/
.ipynb_checkpoints/
*.nbi
*.nbc

# ---- Documentation build (sources are in markdown/) ----
/site/

# ---- LoopSage run results (one folder per run) ----
.scan_cache.pkl
results/
*results*/
output/
*output*/
*.dcd
*.psf
*.pid
*.cif.gz
nohup.out
slurm-*.out
*.log

# ---- Claude / AI assistant files and scratch outputs ----
.claude/
.claude-*/
CLAUDE.md
.cursor/
.aider*
[Cc]laude[ _-]outputs/
outputs/
scratchpad/
.codex/
.gemini/

# ---- Editors and IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# ---- Operating system ----
.DS_Store
.AppleDouble
.Trash-*
Thumbs.db
desktop.ini

# ---- Compiled objects and archives ----
*.so
*.o
*.out
*.zip
*.tar.gz
*.tar.bz2
*.7z

# ---- Temporary folders ----
tmp/
temp/
test/

# ---- Private ideas / notes ----
ideas/
